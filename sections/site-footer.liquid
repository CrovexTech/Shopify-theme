<footer class="site-footer cx-color-scheme color-{{ section.settings.color_scheme }}">
  <div class="page-width site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-logo site-logo--footer" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 260 | image_tag: widths: '130, 195, 260', alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="site-footer__column" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
            <ul role="list">
              {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          {%- when 'newsletter' -%}
            <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
            <p>{{ block.settings.text }}</p>
            {%- form 'customer', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="FooterEmail-{{ block.id }}">{{ 'newsletter.label' | t }}</label>
              <input id="FooterEmail-{{ block.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'newsletter.placeholder' | t }}" required autocomplete="email">
              <button class="button button--primary" type="submit">{{ 'newsletter.button' | t }}</button>
              {%- if form.posted_successfully? -%}<p class="form-status form-status--success">{{ 'newsletter.success' | t }}</p>{%- endif -%}
              {%- if form.errors -%}<div class="form-status form-status--error">{{ form.errors | default_errors }}</div>{%- endif -%}
            {%- endform -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="page-width site-footer__bottom">
    <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.{% if section.settings.footer_credit != blank %} <a href="{{ section.settings.footer_credit_url | default: routes.root_url }}">{{ section.settings.footer_credit }}</a>{% endif %}{% if section.settings.show_shopify_credit %} {{ powered_by_link }}{% endif %}</small>

    {%- if section.settings.show_language_selector and localization.available_languages.size > 1 -%}
      {%- form 'localization', class: 'localization-form' -%}
        <label for="FooterLanguage">{{ 'footer.language' | t }}</label>
        <select id="FooterLanguage" name="language_code" onchange="this.form.submit()">
          {%- for language in localization.available_languages -%}<option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>{%- endfor -%}
        </select>
      {%- endform -%}
    {%- endif -%}
    {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
      {%- form 'localization', class: 'localization-form' -%}
        <label for="FooterCountry">{{ 'footer.country' | t }}</label>
        <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
          {%- for country in localization.available_countries -%}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{%- endfor -%}
        </select>
      {%- endform -%}
    {%- endif -%}
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
      <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-2"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Brand text",
      "default": "<p>Build a storefront that feels unmistakably yours.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_credit",
      "label": "Developer credit",
      "default": "Built by Crovex Tech"
    },
    {
      "type": "url",
      "id": "footer_credit_url",
      "label": "Developer credit link"
    },
    {
      "type": "checkbox",
      "id": "show_shopify_credit",
      "label": "Show Shopify credit",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country selector",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay connected"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Product launches, stories, and private offers."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu"
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
