<section class="section cx-color-scheme color-{{ section.settings.color_scheme }}" data-reveal>
  <div class="page-width">
    <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="feature-grid feature-grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <article class="feature-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{% render 'responsive-image', image: block.settings.image, widths: '300, 450, 600', sizes: '(min-width: 900px) 33vw, 100vw', class: 'feature-card__image', loading: 'lazy', alt: block.settings.heading %}{%- endif -%}
          <h3>{{ block.settings.heading }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank -%}<a class="text-link" href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Framework advantages"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for growth"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Modular by default"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Sections and components remain independent, easier to extend, and easier to test.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
