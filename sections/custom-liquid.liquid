<section class="section cx-color-scheme color-{{ section.settings.color_scheme }}"><div class="page-width">{{ section.settings.custom_liquid }}</div></section>
{% schema %}
{
  "name": "Custom Liquid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-1"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid"
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}
