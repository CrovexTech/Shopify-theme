<section class="hero cx-color-scheme color-{{ section.settings.color_scheme }} hero--{{ section.settings.height }} hero--{{ section.settings.content_position }}{% if section.settings.overlay %} hero--overlay{% endif %}" data-reveal>
  <div class="hero__media">
    {% render 'responsive-image', image: section.settings.image, widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'hero__image', loading: 'eager', alt: section.settings.heading %}
  </div>
  <div class="page-width hero__content-wrap">
    <div class="hero__content" style="--hero-text: {{ section.settings.text_color }}; --hero-max: {{ section.settings.content_width }}px;">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte hero__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--{{ section.settings.button_style }}" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Commerce, designed without compromise."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A flexible storefront system built for distinctive brands and faster iteration.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "large",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "screen",
          "label": "Full screen"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 360,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Add image overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
