<section class="section cx-color-scheme color-{{ section.settings.color_scheme }}"><div class="page-width page-width--narrow"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading | default: page.title }}</h1><div class="rte">{{ section.settings.text }}</div>{%- form 'contact', class: 'contact-form' -%}{%- if form.posted_successfully? -%}<p class="form-status form-status--success">{{ 'contact.success' | t }}</p>{%- endif -%}{{ form.errors | default_errors }}<div class="form-grid"><label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name"></label><label>{{ 'contact.email' | t }}<input type="email" name="contact[email]" value="{{ form.email }}" required autocomplete="email"></label></div><label>{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel"></label><label>{{ 'contact.message' | t }}<textarea name="contact[body]" rows="8" required>{{ form.body }}</textarea></label><button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button>{%- endform -%}</div></section>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Send us a message and our team will respond as soon as possible.</p>"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
