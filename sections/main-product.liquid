{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign initial_media = selected_variant.featured_media | default: product.featured_media -%}
{%- assign product_form_id = 'ProductForm-' | append: section.id -%}
<section class="section product-section cx-color-scheme color-{{ section.settings.color_scheme }}" data-product-root>
  <div class="page-width product-layout product-layout--{{ section.settings.gallery_position }}">
    <div class="product-gallery" data-product-gallery>
      {%- for media in product.media -%}
        <figure class="product-gallery__item" data-media-id="{{ media.id }}"{% unless media.id == initial_media.id %} hidden{% endunless %}>
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {% render 'responsive-image', image: media.preview_image, widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', class: 'product-gallery__image', loading: 'eager', alt: media.alt %}
            {%- when 'video' -%}{{ media | video_tag: controls: true, image_size: '1200x' }}
            {%- when 'external_video' -%}{{ media | external_video_tag }}
            {%- when 'model' -%}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
          {%- endcase -%}
        </figure>
      {%- else -%}
        <div class="media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endfor -%}
      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbs" role="list">
          {%- for media in product.media -%}
            <button type="button" class="product-thumb{% if media.id == initial_media.id %} is-active{% endif %}" data-media-target="{{ media.id }}" aria-label="{{ 'products.product.view_media' | t: index: forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: widths: '80, 120, 160', loading: 'lazy', alt: media.alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- if section.settings.show_vendor -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
      <h1>{{ product.title }}</h1>
      {% render 'price', product: product %}

      {%- if product.description != blank -%}<div class="rte product-description">{{ product.description }}</div>{%- endif -%}

      <product-form>
        {%- form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' -%}
          {%- unless product.has_only_default_variant -%}
            <variant-selector class="variant-selector" data-url="{{ product.url }}">
              {%- for option in product.options_with_values -%}
                <label for="Option-{{ section.id }}-{{ option.position }}">{{ option.name }}</label>
                <select id="Option-{{ section.id }}-{{ option.position }}" data-option-position="{{ option.position }}">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              {%- endfor -%}
            </variant-selector>
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>

          <div class="quantity-field">
            <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
            <div class="quantity-control">
              <button type="button" data-quantity-minus aria-label="{{ 'products.product.decrease_quantity' | t }}">{% render 'icon', name: 'minus' %}</button>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" data-quantity-plus aria-label="{{ 'products.product.increase_quantity' | t }}">{% render 'icon', name: 'plus' %}</button>
            </div>
          </div>

          <button class="button button--primary button--full product-submit" type="submit"{% unless selected_variant.available %} disabled{% endunless %} data-add-to-cart>
            <span data-add-to-cart-text>{% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          </button>
          {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
          <div class="form-status" data-product-status role="status" aria-live="polite"></div>
        {%- endform -%}
      </product-form>

      {%- for block in section.blocks -%}
        <div class="product-block" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when '@app' -%}{% render block %}
            {%- when 'collapsible' -%}
              <details class="accordion"{% if block.settings.open_by_default %} open{% endif %}>
                <summary>{{ block.settings.heading }} {% render 'icon', name: 'chevron' %}</summary>
                <div class="rte accordion__content">{{ block.settings.content }}{{ block.settings.page.content }}</div>
              </details>
            {%- when 'trust' -%}
              <div class="trust-line"><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.text }}</span></div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>
{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout",
      "default": true
    },
    {
      "type": "select",
      "id": "gallery_position",
      "label": "Gallery position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add product information, materials, care instructions, or shipping details.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust line",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Secure checkout"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Encrypted payment processing"
        }
      ]
    }
  ]
}
{% endschema %}
