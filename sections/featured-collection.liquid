{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="section cx-color-scheme color-{{ section.settings.color_scheme }}" data-reveal>
  <div class="page-width">
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | default: collection.title }}</h2>
      </div>
      {%- if collection != blank and section.settings.show_view_all -%}<a class="text-link" href="{{ collection.url }}">{{ 'collections.general.view_all' | t }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
        {%- else -%}
          <p>{{ 'collections.general.no_products' | t }}</p>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card"><div class="product-card__media media-placeholder">{{ 'product-' | append: i | placeholder_svg_tag }}</div><div class="product-card__content"><h3 class="product-card__title">Example product</h3><div class="price">$99.00</div></div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Selected for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
