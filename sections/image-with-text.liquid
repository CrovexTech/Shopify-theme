<section class="section cx-color-scheme color-{{ section.settings.color_scheme }}" data-reveal>
  <div class="page-width image-text image-text--{{ section.settings.layout }}">
    <div class="image-text__media">
      {% render 'responsive-image', image: section.settings.image, widths: '480, 720, 960, 1200', sizes: '(min-width: 900px) 50vw, 100vw', class: 'image-text__image', loading: 'lazy', alt: section.settings.heading %}
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<a class="button button--secondary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Built to evolve"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Add new experiences without rebuilding the core."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Independent components and design tokens make future features easier to implement and maintain.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
