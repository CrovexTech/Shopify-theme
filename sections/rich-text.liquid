<section class="section rich-text-section cx-color-scheme color-{{ section.settings.color_scheme }}" data-reveal>
  <div class="page-width rich-text-section__inner rich-text-section__inner--{{ section.settings.alignment }}" style="--rich-max: {{ section.settings.max_width }}px;">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<p class="eyebrow">{{ block.settings.text }}</p>
          {%- when 'heading' -%}<h2>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}<div class="rte">{{ block.settings.text }}</div>
          {%- when 'button' -%}<a class="button button--{{ block.settings.style }}" href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.label }}</a>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 480,
      "max": 1000,
      "step": 40,
      "unit": "px",
      "label": "Maximum width",
      "default": 720
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Our approach"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "A better foundation for your brand."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Compose pages from flexible sections, consistent design tokens, and progressively enhanced commerce components.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "secondary",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "text",
              "label": "Text"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
