<section class="password-page cx-color-scheme color-{{ section.settings.color_scheme }}"><div class="password-page__inner"><p class="eyebrow">{{ shop.name }}</p><h1>{{ section.settings.heading }}</h1><div class="rte">{{ section.settings.text }}</div>{%- form 'storefront_password', class: 'password-form' -%}{{ form.errors | default_errors }}<label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label><input id="Password" type="password" name="password" placeholder="{{ 'password.placeholder' | t }}" required><button class="button button--primary" type="submit">{{ 'password.enter' | t }}</button>{%- endform -%}</div></section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Enter your email to receive launch updates, or use the store password to enter.</p>"
    }
  ]
}
{% endschema %}
