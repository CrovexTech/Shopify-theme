{%- assign default_scheme = settings.default_color_scheme -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ default_scheme.settings.background | default: '#FFFFFF' }}">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {% style %}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    :root {
      --cx-page-width: {{ settings.page_width }}px;
      --cx-section-space: {{ settings.section_spacing }}px;
      --cx-radius-sm: {{ settings.radius_small }}px;
      --cx-radius-lg: {{ settings.radius_large }}px;
      --cx-font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --cx-font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --cx-font-body-weight: {{ settings.font_body.weight }};
      --cx-font-heading-weight: {{ settings.font_heading.weight }};
    }
    {% render 'color-scheme-styles' %}
  {% endstyle %}
  {{ 'crovex.css' | asset_url | stylesheet_tag }}
</head>
<body class="cx-color-scheme color-{{ settings.default_color_scheme }}">
  <main id="MainContent">{{ content_for_layout }}</main>
</body>
</html>
